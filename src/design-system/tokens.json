    "web": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "native": "System",
    "numeric": "tabular-nums"
  },
  "weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600
  },
  "shape": {
    "cornerSmoothing": 1,
    "web": "squircle",
    "ios": "continuous",
    "android": "rounded fallback"
  },
  "padding": {
    "controlX": 12,
    "controlY": 8,
    "card": 16,
    "compact": 12,
    "screen": 24
