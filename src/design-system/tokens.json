    "none": 0,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 12,
    "full": 9999
  },
  "border": {
    "hairline": 1,
    "focus": 2
  },
  "elevation": {
    "none": "none",
    "low": "0 1px 3px rgb(0 0 0 / 0.04)",
    "raised": "0 4px 16px rgb(0 0 0 / 0.06)",
    "overlay": "0 12px 40px rgb(0 0 0 / 0.16)"
  },
  "motion": {
    "instant": 0,
    "fast": 120,
    "normal": 180,
    "slow": 240,
    "easing": "cubic-bezier(0.2,0,0,1)"
  },
  "opacity": {
    "disabled": 0.45,
    "backdrop": 0.4
  },
  "touch": {
    "minimum": 48,
    "comfortable": 48,
    "ios": 44,
    "android": 48
  },
  "zIndex": {
    "base": 0,
    "sticky": 10,
    "popover": 20,
    "modal": 30,
    "toast": 40
  },
